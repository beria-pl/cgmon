<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cgmon</AssemblyName>
    <RootNamespace>cgmon</RootNamespace>
    <Product>cgmon</Product>
    <Description>Lightweight Windows system tray CPU/GPU temperature monitor</Description>
    <Authors>Piotr Berent</Authors>
    <Company>Piotr Berent</Company>
    <Copyright>Copyright © 2025 Piotr Berent</Copyright>
    <Version>1.1.1</Version>
    <FileVersion>1.1.1.0</FileVersion>
    <Optimize>true</Optimize>
    <Platforms>x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
  </ItemGroup>

</Project>
